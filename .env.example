# ============================================================
# Digital Notice Board Management System - Environment Template
# Copy this file to .env and update values according to your setup.
# ============================================================

# Application Settings
APP_NAME="Digital Notice Board"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Connection (XAMPP / MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=notice_board
DB_USER=root
DB_PASS=

# File Upload Settings
MAX_UPLOAD_SIZE_MB=5
